# Copy to .env and fill in. .env is gitignored; this example file is not.
#
# Most values here have local-development defaults baked into docker-compose.yml
# via ${VAR:-default} interpolation. JWT_SECRET does NOT — Compose refuses to
# start without it, on purpose: a signing key must
# never be committed.

POSTGRES_DB=expense_tracker
POSTGRES_USER=expense_tracker
POSTGRES_PASSWORD=expense_tracker_local

# REQUIRED. HS256 signing key for auth-service. Must be at least 32 bytes;
# the application refuses to start with anything shorter.
#
# Generate a fresh one:
#     printf 'JWT_SECRET=%s\n' "$(openssl rand -base64 48)" >> .env
#
# Never commit the real value. Rotating it invalidates every token in flight.
JWT_SECRET=

# Optional.
JWT_ISSUER=expense-tracker-auth
JWT_EXPIRY=1h
