# Copy to .env to override the local defaults baked into docker-compose.yml.
#
# docker-compose.yml uses ${VAR:-default} interpolation, so `docker compose up`
# works with no .env present. .env is gitignored; this example file is not.
#
# Credentials live here rather than in application source or a committed YAML.

POSTGRES_DB=expense_tracker
POSTGRES_USER=expense_tracker
POSTGRES_PASSWORD=expense_tracker_local
